# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string
# Docker: postgresql://bot:botpass@postgres:5432/githubminer
# Local:  postgresql://bot:botpass@localhost:5432/githubminer
POSTGRES_URL=postgresql://bot:botpass@postgres:5432/githubminer

# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis connection string
# Docker: redis://redis:6379/0
# Local:  redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ============================================
# GITHUB API CONFIGURATION
# ============================================

# GitHub personal access tokens (comma-separated for token rotation)
# Get your token at: https://github.com/settings/tokens
# Scopes needed: public_repo, read:user
GITHUB_TOKENS=ghp_your_token_here

# ============================================
# DOLIBARR CRM INTEGRATION (Optional)
# ============================================

# Dolibarr API endpoint
# Example: https://your-dolibarr.com/api/index.php/atsapi
# Local XAMPP: http://localhost/dolibarr/htdocs/api/index.php/atsapi
DOLIBARR_API=http://localhost/dolibarr/htdocs/api/index.php/atsapi

# Dolibarr API Key
# Generate at: Dolibarr > Setup > API/Web Services
DOLIBARR_KEY=your_dolibarr_api_key_here
